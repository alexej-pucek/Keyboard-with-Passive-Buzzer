    Ds_playing = false;
  }

  if(digitalRead(PIN_Fs) == LOW && !Fs_playing)
  {
    tone(PIN_BUZZER, Fs);
    Serial.println("SOUND");
    Fs_playing = true;
  }
  
  else if(digitalRead(PIN_Fs) == HIGH && Fs_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    Fs_playing = false;
  }

  if(digitalRead(PIN_Gs) == LOW && !Gs_playing)
  {
    tone(PIN_BUZZER, Gs);
    Serial.println("SOUND");
    Gs_playing = true;
  }
  
  else if(digitalRead(PIN_Gs) == HIGH && Gs_playing)
  {
    noTone(PIN_BUZZER);
