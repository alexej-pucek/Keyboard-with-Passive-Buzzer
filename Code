    A_playing = true;
  }
  
  else if(digitalRead(PIN_A) == HIGH && A_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    A_playing = false;
  }

  if(digitalRead(PIN_H) == LOW && !H_playing)
  {
    tone(PIN_BUZZER, H);
    Serial.println("SOUND");
    H_playing = true;
  }
  
  else if(digitalRead(PIN_H) == HIGH && H_playing)
  {
    noTone(PIN_BUZZER);
