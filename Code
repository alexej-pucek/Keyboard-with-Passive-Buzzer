    Gs_playing = false;
  }

  if(digitalRead(PIN_As) == LOW && !As_playing)
  {
    tone(PIN_BUZZER, As);
    Serial.println("SOUND");
    As_playing = true;
  }
  
  else if(digitalRead(PIN_As) == HIGH && As_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    As_playing = false;
  }
  delay(10);
}
