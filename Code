  }
  
  else if(digitalRead(PIN_C2) == HIGH && C2_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    C2_playing = false;
  }

  if(digitalRead(PIN_Cs) == LOW && !Cs_playing)
  {
    tone(PIN_BUZZER, Cs);
    Serial.println("SOUND");
    Cs_playing = true;
  }
  
  else if(digitalRead(PIN_Cs) == HIGH && Cs_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    Cs_playing = false;
  }

  if(digitalRead(PIN_Ds) == LOW && !Ds_playing)
  {
    tone(PIN_BUZZER, Ds);
