const int PIN_C2{4};
const int PIN_H{5};
const int PIN_A{6};
const int PIN_G{7};
const int PIN_F{8};
const int PIN_E{9};
const int PIN_D{10};
const int PIN_C{18};
const int PIN_As{12};
const int PIN_Gs{13};
const int PIN_Fs{14};
const int PIN_Ds{15};
const int PIN_Cs{16};
const int PIN_BUZZER{21};
const int PIN_OCUP{2};
const int PIN_OCDN{1};

int C{65};
int D{73};
int E{82};
int F{87};
int G{98};
int A{110};
int H{123};
int C2{130};
int Cs{69};
int Ds{78};
int Fs{93};
int Gs{104};
int As{117};


bool C_playing{false};
bool D_playing{false};
bool E_playing{false};
bool F_playing{false};
bool G_playing{false};
bool A_playing{false};
bool H_playing{false};
bool C2_playing{false};
bool Cs_playing{false};
bool Ds_playing{false};
bool Fs_playing{false};
bool Gs_playing{false};
bool As_playing{false};

int OCUP_laststate{HIGH};
int OCDN_laststate{HIGH};
int OCUP_currentstate{};
int OCDN_currentstate{};
int octave_multiplier{1};


void setup()
{
  pinMode(PIN_C,INPUT_PULLUP);
  pinMode(PIN_Cs,INPUT_PULLUP);
  pinMode(PIN_D,INPUT_PULLUP);
  pinMode(PIN_Ds,INPUT_PULLUP);
  pinMode(PIN_E,INPUT_PULLUP);
  pinMode(PIN_F,INPUT_PULLUP);
  pinMode(PIN_Fs,INPUT_PULLUP);
  pinMode(PIN_G,INPUT_PULLUP);
  pinMode(PIN_Gs,INPUT_PULLUP);
  pinMode(PIN_A,INPUT_PULLUP);
  pinMode(PIN_As,INPUT_PULLUP);
  pinMode(PIN_H,INPUT_PULLUP);
  pinMode(PIN_C2,INPUT_PULLUP);
  pinMode(PIN_BUZZER,OUTPUT);
  pinMode(PIN_OCUP,INPUT_PULLUP);
  pinMode(PIN_OCDN,INPUT_PULLUP);
  Serial.begin(115200);
  
}

void loop()
{

  OCUP_currentstate = digitalRead(PIN_OCUP);
  OCDN_currentstate = digitalRead(PIN_OCDN);
  
  
  if(digitalRead(PIN_OCUP) == LOW && OCUP_laststate == HIGH && octave_multiplier < 6)
  {
    octave_multiplier += 1;
    
    C *= 2;
    D *= 2;
    E *= 2;
    F *= 2;
    G *= 2;
    A *= 2;
    H *= 2;
    C2 *= 2;
    Cs *= 2;
    Ds *= 2;
    Fs *= 2;
    Gs *= 2;
    As *= 2;

  }

  OCUP_laststate = OCUP_currentstate;


  if(digitalRead(PIN_OCDN) == LOW && OCDN_laststate == HIGH && octave_multiplier > 1)
  {
    octave_multiplier -= 1;
    C /= 2;
    D /= 2;
    E /= 2;
    F /= 2;
    G /= 2;
    A /= 2;
    H /= 2;
    C2 /= 2;
    Cs /= 2;
    Ds /= 2;
    Fs /= 2;
    Gs /= 2;
    As /= 2;

  }

  OCDN_laststate = OCDN_currentstate;
  
  if(digitalRead(PIN_C) == LOW && !C_playing)
  {
    tone(PIN_BUZZER, C);
    Serial.println("SOUND");
    C_playing = true;
  }
  
  else if(digitalRead(PIN_C) == HIGH && C_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    C_playing = false;
  }

  if(digitalRead(PIN_D) == LOW && !D_playing)
  {
    tone(PIN_BUZZER, D);
    Serial.println("SOUND");
    D_playing = true;
  }
  
