    Serial.println("NO SOUND");
    E_playing = false;
  }

  if(digitalRead(PIN_F) == LOW && !F_playing)
  {
    tone(PIN_BUZZER, F);
    Serial.println("SOUND");
    F_playing = true;
  }
  
  else if(digitalRead(PIN_F) == HIGH && F_playing)
  {
    noTone(PIN_BUZZER);
    Serial.println("NO SOUND");
    F_playing = false;
  }

  if(digitalRead(PIN_G) == LOW && !G_playing)
